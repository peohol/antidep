# Antidep – mal for lokale miljøvariabler.
# Kopier til `.env.local` (gitignorert) og fyll inn verdier for ditt utviklingsmiljø.
#
# Kun variabler med VITE_-prefiks eksponeres til nettleserklienten.
# Legg ALDRI Supabase secret-/service_role-nøkler i denne strukturen, i klientkode
# eller i repoet (jf. docs/DATABASE_ARCHITECTURE.md §49).
#
# Lokale verdier: `npm run db:start` (eller `npm run db:status`) skriver ut lokal
# API-URL og publishable-nøkkel for den lokale Supabase-stacken, se supabase/README.md.
# Begge leses av `src/lib/supabase.ts`, som feiler høyt hvis en av dem mangler:
# en app som starter med halv konfigurasjon ender i et tomt resultat som ikke lar
# seg skille fra en tom projeksjon.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Agentkjøreren (ekstraksjonsverifikatoren)
#
# Fire variabler uten VITE_-prefiks, med vilje: Vite eksponerer nøyaktig de
# variablene som HAR prefikset til nettleseren, så et prefiks her ville lagt
# agentens hemmelighet i klientbunten.
#
# Verdiene hører hjemme i `.env.agent.local` (gitignorert) eller i miljøet der
# kjøreren faktisk kjører — aldri i repoet. Hemmeligheten utstedes med
# `./scripts/issue-agent-credential.sh`; se supabase/README.md, avsnittet
# «Legitimasjon til agentidentiteten».
#
# Publishable key, aldri service_role: agenten autentiseres av sin egen
# legitimasjon inne i api-funksjonene, ikke av Data API-rollen.

ANTIDEP_SUPABASE_URL=
ANTIDEP_SUPABASE_PUBLISHABLE_KEY=
ANTIDEP_AGENT_IDENTITY_KEY=agent-identity:extraction-verification-01
ANTIDEP_AGENT_SECRET=
