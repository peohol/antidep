# Antidep – mal for lokale miljøvariabler.
# Kopier bare de delene et lokalt utviklings- eller testløp trenger til en
# gitignorert miljøfil. Ingen hemmeligheter skal commites eller eksponeres med
# VITE_-prefiks.

# Minimal nettklient / framtidig autentisert produktflate.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Felles Data API-adresse for agent- og editor-CLI-er. Bruk publishable key;
# agentene autentiseres i de kontrollerte databasefunksjonene med egne
# rolleavgrensede legitimasjoner, aldri med service_role.
ANTIDEP_SUPABASE_URL=
ANTIDEP_SUPABASE_PUBLISHABLE_KEY=

# Separat ekstraksjonsverifikator.
ANTIDEP_AGENT_IDENTITY_KEY=agent-identity:extraction-verification-01
ANTIDEP_AGENT_SECRET=

# Separat kildestøttekontrollør for synteser.
ANTIDEP_CLAIM_AGENT_IDENTITY_KEY=agent-identity:citation-support-verification-01
ANTIDEP_CLAIM_AGENT_SECRET=

# Lokal dokumentkatalog for de filbaserte agentkjørerne. Den varige lagringen er
# databasen; dette er arbeidskopien en kommando leser originalfilen fra.
ANTIDEP_DOCUMENT_DIR=documents

# Editor-legitimasjon for kommandoen som registrerer en fulltekst og legger
# agentoppgaven i køen. Selve agentarbeidet gjøres fra flaten og trenger ingen
# av disse verdiene.
ANTIDEP_EDITOR_EMAIL=
ANTIDEP_EDITOR_PASSWORD=
# Alternativt kan ANTIDEP_EDITOR_ACCESS_TOKEN settes i miljøet.

# Ekstraksjonsagent.
ANTIDEP_EXTRACTION_AGENT_IDENTITY_KEY=agent-identity:evidence-extraction-01
ANTIDEP_EXTRACTION_AGENT_SECRET=

# Synteseagent.
ANTIDEP_SYNTHESIS_AGENT_IDENTITY_KEY=agent-identity:claim-synthesis-01
ANTIDEP_SYNTHESIS_AGENT_SECRET=

# Separat evidensvurderer.
ANTIDEP_ASSESSMENT_AGENT_IDENTITY_KEY=agent-identity:evidence-assessment-01
ANTIDEP_ASSESSMENT_AGENT_SECRET=

# Antideps private MCP-app, som en planlagt ChatGPT Workspace Agent kobler seg
# til. Appen holder ingen databasehemmelighet av egen kraft: den videresender
# tokenet kalleren la ved, og databasen avgjør hva det får gjøre. Derfor er
# nøkkelen her den publishable, og appen avviser en som gir mer.
#
# ANTIDEP_MCP_BASE_URL settes bare dersom appen står bak noe som gjør at den
# ikke kjenner sin egen adresse. Den brukes til metadatadokumentene og til
# `resource`-parameteren, som må navngi nøyaktig den adressen klienten kalte.
# Se docs/CHATGPT_WORKSPACE_AGENT.md.
ANTIDEP_MCP_BASE_URL=

# Ingen modellnøkkel hører hjemme her. Det semantiske agentarbeidet utføres av
# eksterne KI-agenter gjennom oppgavekontrakten, og Antidep kaller aldri en
# modelleverandør selv: verken OPENAI_API_KEY, ANTHROPIC_API_KEY eller noen
# annen leverandørnøkkel er en forutsetning for å kjøre kjeden.
#
# Gjeldende arkitektur og manglende produktledd er beskrevet i
# docs/EVIDENCE_PIPELINE.md og docs/ROADMAP.md.
