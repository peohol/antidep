# Antidep – mal for lokale miljøvariabler.
# Kopier til `.env.local` (gitignorert) og fyll inn verdier for ditt utviklingsmiljø.
#
# Kun variabler med VITE_-prefiks eksponeres til nettleserklienten.
# Legg ALDRI Supabase secret-/service_role-nøkler i denne strukturen, i klientkode
# eller i repoet (jf. docs/DATABASE_ARCHITECTURE.md §49).
#
# Lokale verdier: `npm run db:start` (eller `npm run db:status`) skriver ut lokal
# API-URL og publishable-nøkkel for den lokale Supabase-stacken, se supabase/README.md.
# Begge leses av `src/lib/supabase.ts`, som feiler høyt hvis en av dem mangler:
# en app som starter med halv konfigurasjon ender i et tomt resultat som ikke lar
# seg skille fra en tom projeksjon.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Agentkjørerne
#
# Ingen av variablene har VITE_-prefiks, med vilje: Vite eksponerer nøyaktig de
# variablene som HAR prefikset til nettleseren, så et prefiks her ville lagt
# agentenes hemmeligheter i klientbunten.
#
# Verdiene hører hjemme i `.env.agent.local` (gitignorert) eller i miljøet der
# kjøreren faktisk kjører — aldri i repoet. Hemmelighetene utstedes med
# `./scripts/issue-agent-credential.sh`; se supabase/README.md, avsnittet
# «Legitimasjon til agentidentiteten».
#
# Publishable key, aldri service_role: agenten autentiseres av sin egen
# legitimasjon inne i api-funksjonene, ikke av Data API-rollen.
#
# URL og nøkkel er miljøets og deles av kjørerne. Legitimasjonen er ikke felles:
# hvert pipelineledd har sin egen rolle, sin egen identitet og sin egen
# hemmelighet, fordi rollen er rettighetsgrensen (migrasjon 005e). Derfor ett
# variabelpar per ledd.

ANTIDEP_SUPABASE_URL=
ANTIDEP_SUPABASE_PUBLISHABLE_KEY=

# Ekstraksjonsverifikatoren (npm run agent:verify-extraction)
ANTIDEP_AGENT_IDENTITY_KEY=agent-identity:extraction-verification-01
ANTIDEP_AGENT_SECRET=

# Claim-verifikatoren (npm run agent:verify-claims)
ANTIDEP_CLAIM_AGENT_IDENTITY_KEY=agent-identity:citation-support-verification-01
ANTIDEP_CLAIM_AGENT_SECRET=

# Modell-leddet (npm run agent:propose-extraction) har ingen variabler her, og
# skal ikke ha noen: det leser en kilde og skriver en fil, og har verken
# databasetilgang eller agentlegitimasjon. Et framtidig leverandøradapter leser
# sin egen API-nøkkel av miljøet på samme måte som kjørerne under, og føres opp
# her når det finnes.

# ----------------------------------------------------------------------------
# Originaldokumentene
#
# En kildeversjon kan være utledet av en fulltekst-PDF (migrasjon 003e). Hvert
# ledd som skal se teksten, slår dokumentet opp på fingeravtrykket sitt i en
# lokal katalog. Standardverdien er `documents/` i repoet, som er gitignorert:
# en forskningsartikkel er opphavsrettslig beskyttet og skal aldri commites
# (docs/EVIDENCE_PIPELINE.md §14, documents/README.md).
#
# Tekstuttrekkingen bruker `pdftotext` fra poppler, og versjonen registreres
# sammen med oppskriften. Uten verktøyet kan ingen dokumentutledet kildeversjon
# hverken registreres eller kontrolleres.

ANTIDEP_DOCUMENT_DIR=documents

# ----------------------------------------------------------------------------
# Redaktørens egen innlogging (npm run editor:assignment)
#
# Kommandoen registrerer en kildeversjon og bygger et ekstraksjonsoppdrag.
# Begge krever `editor`-rollen, som er en menneskelig rolle: det er en
# kvalifisert redaktør som avgjør hvilken artikkel og hvilken avgrensning et
# oppdrag gjelder. Den bruker derfor den samme innloggingen som nettappen — og
# ingen agentlegitimasjon og ingen service_role-nøkkel.
#
# Verdiene hører hjemme i `.env.editor.local` (gitignorert), aldri i repoet.
# Alternativt kan ANTIDEP_EDITOR_ACCESS_TOKEN settes til en gyldig token, når
# en slik allerede finnes.

ANTIDEP_EDITOR_EMAIL=
ANTIDEP_EDITOR_PASSWORD=

# Ekstraksjonsagenten (npm run agent:extract-evidence, npm run agent:reextract-evidence)
#
# Re-ekstraksjonen bruker begge de to øverste parene i den samme prosessen —
# først ekstraksjonen, så den deterministiske kontrollen av nettopp det funnet —
# og to roller kan ikke dele ett variabelnavn.
ANTIDEP_EXTRACTION_AGENT_IDENTITY_KEY=agent-identity:evidence-extraction-01
ANTIDEP_EXTRACTION_AGENT_SECRET=

# Synteseagenten (npm run agent:synthesise-claims)
#
# Leddet som registrerer en foreslått påstandsrevisjon med evidenslenkene sine.
# Eget par av samme grunn som de øvrige: rollen er rettighetsgrensen, og en
# syntesenøkkel kan verken ekstrahere, kontrollere en ekstraksjon, kontrollere
# den påstanden den selv formulerte eller gradere grunnlaget under den.
ANTIDEP_SYNTHESIS_AGENT_IDENTITY_KEY=agent-identity:claim-synthesis-01
ANTIDEP_SYNTHESIS_AGENT_SECRET=

# Evidensvurderingsagenten (npm run agent:assess-evidence)
#
# Leddet som registrerer GRADE-vurderingen for én påstandsrevisjon, etter at
# claim-verifikasjonen har bekreftet påstanden. Eget par, og nettopp derfor: fram
# til migrasjon 005am skrev synteseveien både påstanden og vurderingen med den
# samme legitimasjonen, og ansvarsgrensen EVIDENCE_PIPELINE.md §61 krever, var da
# bare et navn.
ANTIDEP_ASSESSMENT_AGENT_IDENTITY_KEY=agent-identity:evidence-assessment-01
ANTIDEP_ASSESSMENT_AGENT_SECRET=
