# Antidep – mal for lokale miljøvariabler.
# Kopier bare de delene et lokalt utviklings- eller testløp trenger til en
# gitignorert miljøfil. Ingen hemmeligheter skal commites eller eksponeres med
# VITE_-prefiks.

# Minimal nettklient / framtidig autentisert produktflate.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Felles Data API-adresse for agent- og editor-CLI-er. Bruk publishable key;
# agentene autentiseres i de kontrollerte databasefunksjonene med egne
# rolleavgrensede legitimasjoner, aldri med service_role.
ANTIDEP_SUPABASE_URL=
ANTIDEP_SUPABASE_PUBLISHABLE_KEY=

# Separat ekstraksjonsverifikator.
ANTIDEP_AGENT_IDENTITY_KEY=agent-identity:extraction-verification-01
ANTIDEP_AGENT_SECRET=

# Separat kildestøttekontrollør for synteser.
ANTIDEP_CLAIM_AGENT_IDENTITY_KEY=agent-identity:citation-support-verification-01
ANTIDEP_CLAIM_AGENT_SECRET=

# Lokal dokumentkatalog for de filbaserte agentkjørerne. Den varige lagringen er
# databasen; dette er arbeidskopien en kommando leser originalfilen fra.
ANTIDEP_DOCUMENT_DIR=documents

# Editor-legitimasjon for driftskommandoene: `npm run editor:assignment`,
# `npm run ops:full-text` (Antideps eget tekstuttrekk av opplastede fulltekster)
# og `npm run ops:agents` (modelltildeling, kjøreroppsett og recovery-handoff).
# Ingen brukerflate trenger disse verdiene — de hører til deployen.
#
# Den planlagte kjøringen av tekstuttrekket leser de samme verdiene som
# repository secrets i GitHub Actions: ANTIDEP_SUPABASE_URL,
# ANTIDEP_SUPABASE_PUBLISHABLE_KEY, ANTIDEP_EDITOR_EMAIL og
# ANTIDEP_EDITOR_PASSWORD. Mangler de, avslutter kjøringen med en advarsel
# framfor å stå rød.
ANTIDEP_EDITOR_EMAIL=
ANTIDEP_EDITOR_PASSWORD=
# Alternativt kan ANTIDEP_EDITOR_ACCESS_TOKEN settes i miljøet.

# Ekstraksjonsagent.
ANTIDEP_EXTRACTION_AGENT_IDENTITY_KEY=agent-identity:evidence-extraction-01
ANTIDEP_EXTRACTION_AGENT_SECRET=

# Synteseagent.
ANTIDEP_SYNTHESIS_AGENT_IDENTITY_KEY=agent-identity:claim-synthesis-01
ANTIDEP_SYNTHESIS_AGENT_SECRET=

# Separat evidensvurderer.
ANTIDEP_ASSESSMENT_AGENT_IDENTITY_KEY=agent-identity:evidence-assessment-01
ANTIDEP_ASSESSMENT_AGENT_SECRET=

# Antideps private MCP-app, som en planlagt ChatGPT Workspace Agent kobler seg
# til. Appen holder ingen databasehemmelighet av egen kraft: den videresender
# tokenet kalleren la ved, og databasen avgjør hva det får gjøre. Derfor er
# nøkkelen her den publishable, og appen avviser en som gir mer.
#
# I en utrulling som allerede kjører nettklienten, leser MCP-appen de samme
# verdiene fra VITE_SUPABASE_URL og VITE_SUPABASE_PUBLISHABLE_KEY når
# ANTIDEP_-navnene ikke er satt. Det er den samme Data API-adressen og den
# samme publishable nøkkelen; ANTIDEP_-navnene vinner når de er satt.
#
# ANTIDEP_MCP_BASE_URL settes bare dersom appen står bak noe som gjør at den
# ikke kjenner sin egen adresse. Den brukes til metadatadokumentene og til
# `resource`-parameteren, som må navngi nøyaktig den adressen klienten kalte.
# Se docs/CHATGPT_WORKSPACE_AGENT.md.
ANTIDEP_MCP_BASE_URL=

# Nettleseropprinnelser som får kalle MCP-appen, atskilt med komma. Den er tom
# i det vanlige oppsettet: en planlagt kjøring er tjener-til-tjener og oppgir
# ingen opprinnelse, appens egen adresse slipper inn av seg selv over https, og
# loopback slipper inn for utviklingsoppsettet. Sett den bare dersom en
# nettleserklient på en annen adresse faktisk skal kalle appen. Alt annet som
# oppgir en opprinnelse, avvises med 403 før autentiseringen.
ANTIDEP_MCP_ALLOWED_ORIGINS=

# Antideps egen forbindelse for den rå tekniske årsaken, når Data API-et ikke
# svarer.
#
# Hvorfor den finnes: alt annet Antidep gjør mot databasen, går over Data API-et
# med brukerens egen token. Men den rå årsaken skal overleve at nettopp den
# veien er nede — og en lagring som bare virker når det den beskriver ikke
# skjedde, er ingen lagring. Denne adressen er reserven.
#
# Rollen `antidep_diagnostics` opprettes av migrasjonen og kan én ting: kjøre to
# funksjoner som legger til rader. Ingen tabellrettigheter, ingen lesevei, ingen
# bypass av RLS, ingen create. Den er ikke service_role, og ikke i nærheten.
#
# Passordet settes én gang i utrullingen og finnes ikke i repoet — et passord i
# en migrasjon ville ikke vært en hemmelighet. Uten det kan rollen ikke logge
# inn i det hele tatt, og reserven er bare ubrukt: ruten skriver da årsaken i
# kjøreloggen og ber nettleseren beholde den.
#
# Verdien er Supabases egen connection string for prosjektet, med brukernavnet
# byttet til antidep_diagnostics og passordet du satte. Den skal bære
# `sslmode=require`, som Supabases egen streng allerede gjør: TLS avgjøres av
# adressen og ikke av en innstilling i koden.
#
# Server-side alene. Den skal aldri få et VITE_-prefiks, og `npm run
# verify:repo` avviser det.
ANTIDEP_DIAGNOSTICS_DATABASE_URL=

# Ingen modellnøkkel hører hjemme her. Det semantiske agentarbeidet utføres av
# eksterne KI-agenter gjennom oppgavekontrakten, og Antidep kaller aldri en
# modelleverandør selv: verken OPENAI_API_KEY, ANTHROPIC_API_KEY eller noen
# annen leverandørnøkkel er en forutsetning for å kjøre kjeden.
#
# Gjeldende arkitektur og manglende produktledd er beskrevet i
# docs/EVIDENCE_PIPELINE.md og docs/ROADMAP.md.
